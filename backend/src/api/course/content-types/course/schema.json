{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "start_date": {
      "type": "date"
    },
    "users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "inversedBy": "courses"
    },
    "is_active": {
      "type": "boolean"
    },
    "duration": {
      "type": "integer",
      "required": true
    },
    "num_lessons": {
      "type": "integer",
      "required": true
    },
    "course_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-type.course-type",
      "inversedBy": "courses"
    },
    "price": {
      "type": "integer"
    }
  }
}
